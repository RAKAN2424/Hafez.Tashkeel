# GEMINI_API_KEY: Optional cloud fallback key when local models are not mounted.
# Leave empty if running 100% on Local LLMs (Ollama / LM Studio / llama.cpp / Python models).
GEMINI_API_KEY=""

# Local LLM Defaults (Optional - can also be configured directly in the UI Models Map)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"
LOCAL_LLM_URL=""
LOCAL_LLM_MODEL=""

# Custom Per-Slot Model HTTP Endpoints (Optional)
MODEL_ASR_URL=""
MODEL_TTS_URL=""
MODEL_SMART_URL=""
MODEL_RHYME_URL=""
MODEL_PROMPT_URL=""
MODEL_SEARCH_URL=""
MODEL_WEB_AGENT_URL=""
MODEL_VOICE_CLONE_URL=""

# Python executable used when running models/*/predict.py or infer.py
PYTHON_BIN="python3"

# APP_URL: Hosted URL (injected automatically in production/cloud environments)
APP_URL=""
